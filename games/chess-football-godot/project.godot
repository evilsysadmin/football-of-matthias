; Chess Football Godot POC
; Gameplay authority stays inside this project. Manager/persistence are deliberately absent.
config_version=5

[application]
config/name="Chess Football POC"
run/main_scene="res://main.tscn"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.01, 0.018, 0.028, 1)

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="canvas_items"
; Keep the vertical gameplay framing fixed while expanding the visible pitch sideways.
window/stretch/aspect="keep_height"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[input]
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319), Object(InputEventKey,"keycode":4194319)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321), Object(InputEventKey,"keycode":4194321)]
}
move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320), Object(InputEventKey,"keycode":4194320)]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322), Object(InputEventKey,"keycode":4194322)]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
pass_ball={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
shoot_ball={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194309)]
}
change_player={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194306), Object(InputEventKey,"physical_keycode":81)]
}
tackle={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
special_move={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":70)]
}
toggle_view={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":86)]
}
